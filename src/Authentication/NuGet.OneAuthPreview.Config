<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="InternalPreview" value="https://pkgs.dev.azure.com/azure-sdk/internal/_packaging/azure-sdk-for-net-pr/nuget/v3/index.json" />
    <add key="OneAuth" value="https://office.pkgs.visualstudio.com/_packaging/OneAuth/nuget/v3/index.json" />
    <add key="AzureSdkPublic" value="https://pkgs.dev.azure.com/azure-sdk/public/_packaging/azure-sdk-for-net/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="InternalPreview">
      <package pattern="Azure.Core" />
      <package pattern="Azure.Identity.Broker" />
    </packageSource>
    <packageSource key="OneAuth">
      <package pattern="Microsoft.Authentication.Client" />
    </packageSource>
    <packageSource key="AzureSdkPublic">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
