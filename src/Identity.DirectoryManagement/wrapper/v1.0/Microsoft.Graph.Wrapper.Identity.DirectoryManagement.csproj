<!-- Generated by tools/Build-WrapperModule.ps1. Regenerate rather than edit by hand. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the client project's framework and the framework the shipping module
         manifest can load; see the rationale in WrapperClient.csproj.template. Microsoft.Graph.Authentication,
         which this project references, is netstandard2.0 for the same reason. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Microsoft.Graph.Wrapper.Identity.DirectoryManagement</AssemblyName>
    <!-- Copy the dependency closure into bin, then PruneModuleBin (below) cuts it down to
         exactly what the module folder may carry. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Without this the SDK follows Client/Runtime through to Microsoft.Graph.Authentication.Core
         and copies it here as a transitive project output, which no asset attribute on the direct
         references can stop. The installed Microsoft.Graph.Authentication module must be the only
         source of the Authentication assemblies at run time (see PruneModuleBin). -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Cmdlets\**\*.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- This package exists only to compile against the PowerShell SDK contract; the host
         supplies the real System.Management.Automation at run time, and shipping a second copy
         would shadow it. The two attributes do different jobs and both are needed:
         PrivateAssets="all" stops the compile-only dependency flowing to consumers of a packed
         wrapper; ExcludeAssets="runtime" stops its runtime asset entering this project's own
         runtime dependency manifest and copy-local output.
         Neither can be inferred from the restore graph, because the package publishes the same
         System.Management.Automation.dll as BOTH its compile and its runtime asset - so the
         intent has to be declared here rather than filtered out later when packaging. -->
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Client\Client.csproj" />
    <!-- Compile against the repo's Authentication project, but never copy it: at run time the
         manifest's RequiredModules loads the installed Microsoft.Graph.Authentication, and a
         module-local copy is a second assembly with a second GraphSession static. -->
    <ProjectReference Include="..\..\..\Authentication\Authentication\Microsoft.Graph.Authentication.csproj" Private="false" />
    <ProjectReference Include="..\..\..\GraphWrapperRuntime\Runtime\Microsoft.Graph.Wrapper.Runtime.csproj" />
  </ItemGroup>

  <!-- The module folder may carry ONLY the wrapper assemblies plus the kiota dependencies the
       installed Microsoft.Graph.Authentication module does not ship (Std.UriTemplate,
       Microsoft.Kiota.Serialization.Multipart). Every other dependency must resolve from that
       module's isolated load context: a copy here loads a second type identity into the default
       context, and the first request through the shared session pipeline dies casting between
       the two (proven live: ObservabilityOptions, kiota middleware vs wrapper adapter).
       Removal is by package identity, not filename, so the kept assemblies' versions stay
       derived from the restore graph instead of being pinned here. -->
  <Target Name="PruneModuleBin" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' != '' And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Std.UriTemplate' And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Microsoft.Kiota.Serialization.Multipart'" />
    </ItemGroup>
  </Target>

</Project>
