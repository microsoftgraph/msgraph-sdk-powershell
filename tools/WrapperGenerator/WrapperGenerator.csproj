<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WrapperGenerator</AssemblyName>
    <RootNamespace>WrapperGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.OpenApi reads the spec; YamlReader is required for the .yml specs.
         Microsoft.Extensions.Logging.Abstractions supplies ILogger and the [LoggerMessage] source
         generator the generation service uses. -->
    <PackageReference Include="Microsoft.OpenApi" Version="3.7.0" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.7.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oracle-derived collision resolutions (tools/Derive-CollisionResolutions.ps1), embedded
         so a generation run never depends on a working directory or the 22 MB oracle. -->
    <EmbeddedResource Include="data\collision-*.json" />
    <!-- Oracle-derived parity resolutions (tools/Derive-ParityResolutions.ps1): full-surface
         renames and suppressions, same schema and reader as the collision data. -->
    <EmbeddedResource Include="data\parity-*.json" />
  </ItemGroup>

</Project>
